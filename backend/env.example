# ==================== AI API Configuration ====================
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Provider: 'volcano' or 'baijia'
LLM_PROVIDER=baijia

# Baijia LLM Configuration
BAIJIA_API_KEY=sk-7BfuPhPxtPMjaAJn86vR2g
BAIJIA_MODEL=claude-4.5-sonnet

# Volcano Engine Configuration
VOLCANO_ACCESS_KEY=your_volcano_access_key
VOLCANO_SECRET_KEY=your_volcano_secret_key
VOLCANO_MODEL=your_volcano_model

# ==================== API Proxy Configuration ====================
# API 转发服务地址
# 本地开发: http://localhost:8001
# 线上环境: https://learnorbit.gaotu.cn
API_PROXY_URL=http://localhost:8001

# ==================== Proxy IP Configuration (for Bilibili) ====================
# 代理IP服务配置（用于B站API请求，避免HTTP 412错误）
# 代理IP获取接口URL
PROXY_API_URL=http://dl.pcdaili.com:800/user/webapi/getip.php
# 代理IP服务CDK密钥
PROXY_CDK=B0F4D14883EE13A1F4F331FF92894555
# 获取的代理数量（默认40）
PROXY_NUM=40
# 过滤参数（默认1）
PROXY_FILTER=1
# 最近N小时的代理（默认2）
PROXY_LASTHOUR=2
# 地区过滤（可选，留空表示不限制）
PROXY_AREA=

# ==================== Application Security ====================
SECRET_KEY=your_secret_key_here

# ==================== Server Configuration ====================
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ==================== File Upload Configuration ====================
MAX_UPLOAD_SIZE=104857600
UPLOAD_DIR=uploads

# ==================== CORS Configuration ====================
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
