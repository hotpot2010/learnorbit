# ==================== AI API Configuration ====================
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Provider: 'volcano' or 'baijia'
LLM_PROVIDER=baijia

# Baijia LLM Configuration
BAIJIA_API_KEY=sk-7BfuPhPxtPMjaAJn86vR2g
BAIJIA_MODEL=claude-4.5-sonnet

# Volcano Engine Configuration
VOLCANO_ACCESS_KEY=your_volcano_access_key
VOLCANO_SECRET_KEY=your_volcano_secret_key
VOLCANO_MODEL=your_volcano_model

# ==================== API Proxy Configuration ====================
# API 转发服务地址
# 本地开发: http://localhost:8001
# 线上环境: https://learnorbit.gaotu.cn
API_PROXY_URL=http://localhost:8001

# ==================== Application Security ====================
SECRET_KEY=your_secret_key_here

# ==================== Server Configuration ====================
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ==================== File Upload Configuration ====================
MAX_UPLOAD_SIZE=104857600
UPLOAD_DIR=uploads

# ==================== CORS Configuration ====================
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
