# ==================== 生产环境配置 ====================
# 复制此文件为 .env 用于生产部署

# ==================== API Proxy Configuration ====================
# 线上 API 转发服务
API_PROXY_URL=https://learnorbit.gaotu.cn

# ==================== AI API Configuration ====================
# LLM Provider: 'volcano' or 'baijia'
LLM_PROVIDER=baijia

# Baijia LLM Configuration
BAIJIA_API_KEY=sk-7BfuPhPxtPMjaAJn86vR2g
BAIJIA_MODEL=claude-4.5-sonnet

# ==================== Server Configuration ====================
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ==================== File Upload Configuration ====================
MAX_UPLOAD_SIZE=104857600
UPLOAD_DIR=uploads

# ==================== CORS Configuration ====================
CORS_ORIGINS=["https://www.aitutorly.ai", "https://aitutorly.ai"]


