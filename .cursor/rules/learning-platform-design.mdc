```

### 12.2 会话状态（sessionStorage）

```tsx
// 页面刷新保持的状态
const [sessionId] = useState(() => {
  if (typeof window !== 'undefined') {
    const cached = sessionStorage.getItem('sessionId');
    if (cached) return cached;
  }
  const id = crypto.randomUUID();
  sessionStorage.setItem('sessionId', id);
  return id;
});
```

### 12.3 全局状态（Zustand）

```tsx
// store/learning-store.ts
import { create } from 'zustand';

interface LearningStore {
  currentPlan: LearningPlan | null;
  currentStep: number;
  setCurrentPlan: (plan: LearningPlan) => void;
  setCurrentStep: (step: number) => void;
}

export const useLearningStore = create<LearningStore>((set) => ({
  currentPlan: null,
  currentStep: 0,
  setCurrentPlan: (plan) => set({ currentPlan: plan }),
  setCurrentStep: (step) => set({ currentStep: step }),
}));
```

## 13. 错误处理和反馈 🚨

### 13.1 错误边界

```tsx
// components/error-boundary.tsx
import { Component, ReactNode } from 'react';

class ErrorBoundary extends Component<
  { children: ReactNode; fallback?: ReactNode },
  { hasError: boolean }
> {
  state = { hasError: false };

  static getDerivedStateFromError() {
    return { hasError: true };
  }

  componentDidCatch(error: Error, errorInfo: any) {
    console.error('Error caught:', error, errorInfo);
  }

  render() {
    if (this.state.hasError) {
      return this.props.fallback || (
        <div className="text-center py-12">
          <h2 className="text-2xl font-bold text-red-600 mb-4">出错了 😕</h2>
          <p className="text-gray-600">请刷新页面重试</p>
        </div>
      );
    }

    return this.props.children;
  }
}
```

