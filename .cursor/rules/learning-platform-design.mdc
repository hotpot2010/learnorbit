const handleUpdateTask = async (taskId: string, updates: any) => {
  // 立即更新 UI
  setTasks(prev => prev.map(t => 
    t.id === taskId ? { ...t, ...updates } : t
  ));
  
  try {
    // 发送到服务器
    await updateTask(taskId, updates);
    toast.success('更新成功');
  } catch (error) {
    // 回滚
    setTasks(originalTasks);
    toast.error('更新失败');
  }
};
```

